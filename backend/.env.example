# Copy to backend/.env and fill in.
DATABASE_URL=postgresql+psycopg://localhost/life_brain
# JSON list of browser origins allowed to call the API
CORS_ORIGINS=["http://localhost:3000"]

# LLM — any OpenAI-compatible API (defaults: Groq free tier, key from console.groq.com)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
CAPTURE_MODEL=openai/gpt-oss-20b
ASK_MODEL=openai/gpt-oss-120b
FALLBACK_MODEL=openai/gpt-oss-20b

# Optional paid fallback, used only when every Groq model is rate-limited or down.
# Leave empty to never pay. Key from https://console.anthropic.com
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
# Order providers are tried in (JSON list): ["groq"] = free only, ["claude"] = Claude only
PROVIDERS=["groq", "claude"]
